{
  "name": "drishx-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --lan --port 8085",
    "start:clear": "expo start --lan -c --port 8085",
    "start:tunnel": "expo start --tunnel --port 8085",
    "reset-project": "node ./scripts/reset-project.js",
    "process-lens-assets": "node ./scripts/process-lens-assets.js",
    "android": "expo run:android --port 8085",
    "android:dev": "expo run:android --device --port 8085",
    "android:prod": "expo run:android --device --variant release --port 8085",
    "ios": "expo run:ios --port 8085",
    "ios:dev": "expo run:ios --device --port 8085",
    "ios:prod": "expo run:ios --device --configuration Release --port 8085",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
