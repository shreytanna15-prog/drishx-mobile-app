    # Local dev: use your PC Wi-Fi IPv4 from `ipconfig` (Wireless LAN adapter Wi-Fi).
    # Do NOT use WSL/Hyper-V addresses (172.24.x.x) — phones cannot reach them.
    #
    # After changing this file, restart Metro:
    #   npm run start:clear
    #
    # If same Wi-Fi still fails (Windows firewall), use:
    #   npm run start:tunnel
    #
    # EXPO_PUBLIC_BACKEND_BASE_URL=http://192.168.10.237:3000
    # http://10.85.38.83:3000
    # REACT_NATIVE_PACKAGER_HOSTNAME=10.85.38.83
    EXPO_PUBLIC_BACKEND_BASE_URL=https://drishx-admin-and-backend.vercel.app
    EAS_SKIP_AUTO_FINGERPRINT=1
    #http://192.168.10.237:3000