# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Local QA screenshots / screen recordings (never commit)
/screenshots/
**/screenshots/
*.screenshot.png
*.screenshot.jpg
page-*.png
page-*.jpg

# macOS
.DS_Store
*.pem

# local env files
.env*
!.env.example

# local credentials and private signing material
.npmrc
.netrc
.pypirc
.ssh/
id_rsa
id_ed25519
*.pfx
*.keystore
*service-account*.json
*credentials*.json
google-services.json
GoogleService-Info.plist
secrets.json
secrets.*.json
*.secret.*
/backups/
*.dump
*.backup
*.sqlite
*.sqlite3

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
config.bat

# Never reintroduce malware droppers / scratch junk
/init
/api.js
/abc.txt
/test.txt
/commit.txt
